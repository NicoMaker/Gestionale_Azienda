flowchart LR
  subgraph FRONT["front/ (browser)"]
    APP[app.js router] --> SB[sidebar]
    APP --> DB[dashboard]
    APP --> PG[entity-page]
    PG --> DT[data-table]
    PG --> MF[modal-form]
    PG --> TS[toast]
    CFG[config/entities.js] --> PG
    API[core/api.js]
  end
  subgraph BACK["back/ (Node + Express)"]
    SRV[server.js] --> RC[clienti.routes]
    SRV --> RP[prodotti.routes]
    SRV --> RF[fatture.routes]
    SRV --> RD[dashboard.routes]
    RC & RP & RF --> CRUD[crud.js]
    CRUD --> SQL[(SQLite gestionale.db)]
    RD --> SQL
  end
  DB --> API
  PG --> API
  API -- "/api/*" --> SRV
